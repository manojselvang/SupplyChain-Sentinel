# ============================================================
# SupplyChain Sentinel Backend - Environment Variables
# Copy to .env and adjust values for your environment.
# NEVER commit the real .env file to version control.
# ============================================================

# Spring profile: dev | docker | prod
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplychain_sentinel
DB_USERNAME=postgres
DB_PASSWORD=Water

# CORS - comma-separated list of allowed frontend origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# JWT configuration
# Secret must be at least 32 characters (256 bits). Use a strong random value in production.
JWT_SECRET=change-me-to-a-256-bit-secret-key-at-least-32-characters-long
JWT_ISSUER=supplychain-sentinel
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Cookie security (set to true when serving over HTTPS)
APP_COOKIE_SECURE=false

# Brute-force protection
APP_MAX_LOGIN_ATTEMPTS=5
APP_LOCKOUT_DURATION_MINUTES=15

# Initial admin user provisioning (set on first startup to create an admin)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password
INITIAL_ADMIN_EMAIL=admin@supplychainsentinel.local
