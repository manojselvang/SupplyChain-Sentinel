# ============================================================
# SupplyChain Sentinel Frontend - Environment Variables
# Copy to .env and adjust values for your environment.
# NEVER commit the real .env file to version control.
# ============================================================

# API base URL - in dev, Vite proxies /api to the backend.
# For standalone/production builds, set this to the backend URL.
VITE_API_BASE_URL=http://localhost:8080/api/v1
